# Development-only flags. Copy to `.env.local` (which is gitignored) and edit.

# Backend API base URL. The production fallback in src/api.ts points to the
# Cloudflare Worker, so leaving this unset works against production from
# anywhere. Override to point at a local `wrangler dev` instance if needed.
VITE_API_BASE_URL=https://where-in-the-citi-backend.kazumasa-umemoto.workers.dev

# When 'true', the app loads src/fixtures/current.json instead of polling the
# backend. Use for visual iteration without waiting for live updates. Never
# set this in a production build — fixture data is stale by definition.
VITE_USE_FIXTURES=false
